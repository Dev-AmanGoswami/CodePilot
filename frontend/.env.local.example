# Copy to .env.local and adjust.

# Data source for the frontend:
#   mock -> in-browser localStorage + simulated streaming (default, no backend needed)
#   http -> real REST calls to your backend via the typed HTTP adapter
NEXT_PUBLIC_API_MODE=mock

# When NEXT_PUBLIC_API_MODE=http, requests go to /api/* and are proxied here
# (configured in next.config.mjs). Point this at your Spring backend.
# BACKEND_URL=http://localhost:8080
